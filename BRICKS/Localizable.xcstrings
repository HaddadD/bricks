    "Clear a 3×3 area — aim it, then confirm" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rydder et 3×3-område — sigt, og bekræft så"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räumt ein 3×3-Feld — zielen, dann bestätigen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Despeja un área de 3×3: apunta y confirma"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libère une zone 3×3 — visez, puis confirmez"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera un'area 3×3: mira, poi conferma"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3×3の範囲を消す——狙ってから確定"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3×3 범위를 지웁니다 — 조준한 뒤 확정"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt een 3×3-gebied vrij — richt, dan bevestigen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czyści obszar 3×3 — wyceluj, potem potwierdź"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpa uma área 3×3: mire e confirme"
          }
        },
