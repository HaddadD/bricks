    "A gift appeared — clear its line!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Geschenk — räum seine Reihe frei!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出现礼物了——消除它所在的那一排！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出現禮物了——消除它所在的那一排！"
          }
        }
      }
    },
    "A gift appeared!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Geschenk ist da!"
          }
        },
        "zh-Hans" : {
