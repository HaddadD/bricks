          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップで3つとも回転——終わったらピースをドラッグ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭하면 셋 다 회전 — 끝나면 조각을 끌어다 놓으세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk for å snu alle tre — dra en brikke når du er ferdig"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik om alle drie te draaien — sleep een blok als je klaar bent"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
