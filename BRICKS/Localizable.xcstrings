    "Update BRICKS! from the App Store to keep playing." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdater BRICKS! i App Store for at spille videre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere BRICKS! im App Store, um weiterzuspielen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza BRICKS! desde el App Store para seguir jugando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mets BRICKS! à jour depuis l'App Store pour continuer à jouer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna BRICKS! dall'App Store per continuare a giocare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遊び続けるには、App StoreでBRICKS!をアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속 플레이하려면 App Store에서 BRICKS!를 업데이트하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk BRICKS! bij in de App Store om te blijven spelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaktualizuj BRICKS! w App Store, żeby grać dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize o BRICKS! na App Store para continuar jogando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualiza o BRICKS! na App Store para continuares a jogar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обнови BRICKS! в App Store, чтобы продолжить играть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdatera BRICKS! i App Store för att fortsätta spela."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynamaya devam etmek için BRICKS!'i App Store'dan güncelle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请前往 App Store 更新 BRICKS! 以继续游戏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請前往 App Store 更新 BRICKS! 以繼續遊戲。"
          }
        }
      }
    },
    "Update to keep playing. Your game and best score are saved." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdater for at spille videre. Dit spil og din bedste score er gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere, um weiterzuspielen. Spiel und Bestwert bleiben gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza para seguir jugando. Tu partida y tu récord están guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mets à jour pour continuer à jouer. Ta partie et ton record sont sauvegardés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna per continuare a giocare. La partita e il record sono salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートすれば続けて遊べます。ゲームとベストスコアは保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트하면 계속 플레이할 수 있습니다. 게임과 최고 점수는 저장되어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk bij om te blijven spelen. Je spel en beste score zijn bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaktualizuj, żeby grać dalej. Twoja gra i rekord są zapisane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize para continuar jogando. Sua partida e seu recorde estão salvos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualiza para continuares a jogar. O teu jogo e o teu recorde estão guardados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обнови, чтобы продолжить играть. Игра и рекорд сохранены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdatera för att fortsätta spela. Spelet och ditt rekord är sparade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynamaya devam etmek için güncelle. Oyunun ve rekorun kayıtlı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新后即可继续游戏。你的进度和最高分都会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新後即可繼續遊戲。你的進度和最高分都會保留。"
          }
        }
      }
