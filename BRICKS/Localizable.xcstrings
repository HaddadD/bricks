    "Clear a 3×3 area — aim it, then confirm" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyčistí oblast 3×3 — zamiř a potvrď"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rydder et 3×3-område — sigt, og bekræft så"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räumt ein 3×3-Feld — zielen, dann bestätigen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
