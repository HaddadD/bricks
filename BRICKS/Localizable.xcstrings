    "Five of each, at most. Tap one to use it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejvýš pět z každé. Klepnutím ji použiješ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højst fem af hver. Tryk på en for at bruge den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchstens fünf von jeder. Tippe eine an, um sie zu nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
