    "Turn all three pieces a quarter turn, as often as you like" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira les tres peces un quart de volta, tantes vegades com vulguis"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otočí všechny tři dílky o 90°, kolikrát chceš"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drejer alle tre brikker en kvart omgang, så ofte du vil"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreht alle drei Teile um 90°, so oft du willst"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γυρίζει και τα τρία κομμάτια κατά 90°, όσες φορές θέλεις"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira las tres piezas un cuarto de vuelta, tantas veces como quieras"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kääntää kaikkia kolmea palaa neljänneskierroksen, niin usein kuin haluat"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tourne les trois pièces d'un quart de tour, aussi souvent que tu veux"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तीनों टुकड़ों को 90° घुमाता है, जितनी बार चाहें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okreće sva tri dijela za 90°, koliko puta želiš"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindhárom elemet negyed fordulattal elforgatja, ahányszor csak akarod"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira tutti e tre i pezzi di un quarto di giro, quante volte vuoi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3つのピースを90度ずつ回転。何度でも回せます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세 조각을 90도씩 회전합니다. 몇 번이든 가능"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snur alle tre brikkene en kvart omdreining, så ofte du vil"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draait alle drie de blokken een kwartslag, zo vaak als je wilt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obraca wszystkie trzy klocki o 90°, ile razy chcesz"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira as três peças um quarto de volta, quantas vezes você quiser"
