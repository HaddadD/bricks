            "value" : "Klepnutím otočíš všechny tři — pak dílek přetáhni"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at dreje alle tre — træk en brik når du er færdig"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antippen dreht alle drei — zum Beenden ein Teil ziehen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτα για να γυρίσουν και τα τρία — μετά σύρε ένα κομμάτι"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para girar las tres; arrastra una pieza al terminar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta kääntääksesi kaikki kolme — vedä sitten palaa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche pour tourner les trois — fais glisser une pièce pour finir"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotakni da okreneš sva tri — zatim povuci dio"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints, hogy mindhárom forduljon — aztán húzz egy elemet"
