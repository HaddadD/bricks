    "This board and your score will be lost. Your power-ups are kept." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdràs aquest tauler i la teva puntuació. Els potenciadors es mantenen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato deska a tvé skóre budou ztraceny. Pomůcky zůstanou."
