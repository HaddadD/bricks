          "stringUnit" : {
            "state" : "translated",
            "value" : "Un regalo: libera la sua riga!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ギフト出現——その列を消そう！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선물 등장 — 그 줄을 지우세요!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gave — tøm raden dens!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een cadeau — maak die rij vrij!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezent — wyczyść jego linię!"
