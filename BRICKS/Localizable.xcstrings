    "Widget is off.\nTurn it on in BRICKS! settings." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget je vypnutý.\nZapni ho v nastavení BRICKS!."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgetten er slået fra.\nSlå den til i indstillingerne for BRICKS!."
          }
        },
        "de" : {
          "stringUnit" : {
