    "A gift appeared — clear its line!" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dárek — vyčisti jeho řadu!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gave — ryd dens række!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Geschenk — räum seine Reihe frei!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα δώρο — καθάρισε τη γραμμή του!"
          }
        },
